FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel

# Copy the uv binary from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy lock files and project definitions
COPY pyproject.toml uv.lock ./

# Synchronize python environment (frozen lock dependencies)
RUN uv sync --frozen --no-dev

# Copy backend codebase
COPY . /app/backend

# Configure python path and cache locations
ENV PYTHONPATH=/app
ENV HF_HOME=/root/.cache/huggingface
VOLUME ["/root/.cache/huggingface"]

EXPOSE 8000

# Run uvicorn using the synchronized virtualenv
CMD ["/app/.venv/bin/uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
